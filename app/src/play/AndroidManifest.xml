<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Google Play build only: Play updates the app, so the GitHub self-updater's install permissions and its result
         receiver are removed (Play doesn't allow apps to install updates from elsewhere). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" tools:node="remove" />

    <application>
        <receiver android:name=".InstallResultReceiver" tools:node="remove" />
    </application>
</manifest>
