<?xml version="1.0" encoding="utf-8"?>
<!-- Never back up or transfer the Amizone session cookies (prefs.xml), anything from the LMS (its session, saved data, downloaded files and scans) or the WebView's own cookie store. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="prefs.xml" />
        <exclude domain="sharedpref" path="secure_session.xml" />
        <exclude domain="sharedpref" path="secure_login.xml" />
        <exclude domain="sharedpref" path="secure_lms.xml" />
        <exclude domain="sharedpref" path="lms_data.xml" />
        <exclude domain="file" path="lms_files" />
        <exclude domain="file" path="scans" />
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="prefs.xml" />
        <exclude domain="sharedpref" path="secure_session.xml" />
        <exclude domain="sharedpref" path="secure_login.xml" />
        <exclude domain="sharedpref" path="secure_lms.xml" />
        <exclude domain="sharedpref" path="lms_data.xml" />
        <exclude domain="file" path="lms_files" />
        <exclude domain="file" path="scans" />
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
