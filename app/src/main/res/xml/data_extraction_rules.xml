<?xml version="1.0" encoding="utf-8"?>
<!-- Never back up or transfer the Amizone session cookies (prefs.xml) or the WebView's own cookie store. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="prefs.xml" />
        <exclude domain="sharedpref" path="secure_session.xml" />
        <exclude domain="sharedpref" path="secure_login.xml" />
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="prefs.xml" />
        <exclude domain="sharedpref" path="secure_session.xml" />
        <exclude domain="sharedpref" path="secure_login.xml" />
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
