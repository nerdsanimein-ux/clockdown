<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/troot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:id="@+id/theader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:paddingStart="6dp"
        android:text="Coming up"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/r0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_bg_0"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <TextView
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
            android:id="@+id/r0_emoji"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_badge_light"
            android:gravity="center"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
                android:id="@+id/r0_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
                android:id="@+id/r0_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B0FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <Chronometer
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
            android:id="@+id/r0_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/r1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_bg_1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <TextView
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
            android:id="@+id/r1_emoji"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_badge_light"
            android:gravity="center"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
                android:id="@+id/r1_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
                android:id="@+id/r1_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B0FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <Chronometer
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
            android:id="@+id/r1_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/r2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_bg_2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <TextView
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
            android:id="@+id/r2_emoji"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_badge_light"
            android:gravity="center"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
                android:id="@+id/r2_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
                android:id="@+id/r2_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B0FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <Chronometer
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
            android:id="@+id/r2_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/r3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_bg_3"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <TextView
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
            android:id="@+id/r3_emoji"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_badge_light"
            android:gravity="center"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
                android:id="@+id/r3_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
                android:id="@+id/r3_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B0FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <Chronometer
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
            android:id="@+id/r3_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="17sp" />
    </LinearLayout>

    <TextView
        android:shadowColor="#E6FFFFFF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:id="@+id/tempty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:gravity="center"
        android:text="No upcoming events"
        android:textColor="@color/white"
        android:textSize="16sp" />
</LinearLayout>
